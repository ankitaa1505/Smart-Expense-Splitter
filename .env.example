# ==============================================================================
# Smart Expense Tracker - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR LOCAL DEV / PRODUCTION.
# NEVER COMMIT THE ACTUAL .env FILE CONTAINING SENSITIVE SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_expense_tracker
DB_USER=expense_user
DB_PASSWORD=expense_secret_password
DB_ROOT_PASSWORD=root_secret_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
# Note: In production, generate a secure 256-bit (32-byte) or 512-bit Base64 string.
# Example command: openssl rand -base64 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
